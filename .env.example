# Leave GROQ_API_KEY blank to run entirely on the deterministic mock LLM
# (useful for tests and a zero-cost demo). Set it to use real Groq calls.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Docker Compose sets this itself; override for local (non-Docker) runs.
DATABASE_URL=postgresql://taskgraph:taskgraph@localhost:5432/taskgraph

STORAGE_DIR=./artifacts
TASK_TIMEOUT_SECONDS=30
TASK_MEMORY_LIMIT_MB=256
MAX_TASK_ATTEMPTS=3
CLAIM_HEARTBEAT_TIMEOUT_SECONDS=120
